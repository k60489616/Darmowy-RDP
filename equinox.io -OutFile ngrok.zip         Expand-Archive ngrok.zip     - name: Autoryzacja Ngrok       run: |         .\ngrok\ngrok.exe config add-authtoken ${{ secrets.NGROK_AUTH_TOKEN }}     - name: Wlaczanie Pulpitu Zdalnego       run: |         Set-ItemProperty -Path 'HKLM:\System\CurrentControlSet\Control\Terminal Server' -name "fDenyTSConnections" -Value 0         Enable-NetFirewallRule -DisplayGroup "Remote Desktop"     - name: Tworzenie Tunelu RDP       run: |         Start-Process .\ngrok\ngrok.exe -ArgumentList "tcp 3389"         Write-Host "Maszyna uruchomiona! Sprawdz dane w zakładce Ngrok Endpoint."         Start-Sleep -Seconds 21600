name: Windows-RDP

on: workflow_dispatch

jobs:
  build:
    runs-on: windows-latest
    steps:
    - name: Pobieranie Ngrok
      run: |
        Invoke-WebRequest https://equinox.io -OutFile ngrok.zip
        Expand-Archive ngrok.zip
    - name: Autoryzacja Ngrok
      run: |
        .\ngrok\ngrok.exe config add-authtoken ${{ secrets.NGROK_AUTH_TOKEN }}
    - name: Wlaczanie Pulpitu Zdalnego
      run: |
        Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -name "fDenyTSConnections" -Value 0
        Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
    - name: Tworzenie Tunelu RDP
      run: |
        Start-Process .\ngrok\ngrok.exe -ArgumentList "tcp 3389"
        Write-Host "Maszyna uruchomiona! Sprawdz dane w zakładce Ngrok Endpoint."
        Start-Sleep -Seconds 21600
